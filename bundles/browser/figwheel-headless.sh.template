#!/bin/sh
set -eu

here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
profile="$here/target/figwheel-chrome-profile"

# exec so figwheel's teardown signals chromium itself rather than this wrapper,
# and an explicit --user-data-dir so the profile never lands on a RAM-backed /tmp.
pkill -f -- "--user-data-dir=$profile" 2>/dev/null || true
rm -rf -- "$profile"
mkdir -p -- "$profile"

exec chromium --headless --disable-gpu --remote-debugging-port=9222 --repl \
  --user-data-dir="$profile" "$@"
